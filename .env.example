# Model: large-v3 (paling akurat) | large-v3-turbo (lebih cepat)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
# Turunkan ke 4 jika muncul error "out of memory"
WHISPER_BATCH=8
WHISPER_BEAM=5
WHISPER_LANG=id
# VAD = penyaring bagian hening. 1 = aktif (bawaan). 0 = mati: bacaan Arab yang pelan/dilantunkan
# lebih mungkin tertangkap, tetapi halusinasi di bagian hening bisa naik. Hanya untuk backend lokal (GPU/CPU).
WHISPER_VAD=1

# Backend: auto (GPU NVIDIA -> Groq API -> CPU) | lokal | groq | cpu
WHISPER_BACKEND=auto
# Groq API untuk PC/VPS tanpa GPU NVIDIA (whisper-large-v3 ~$0.11 per jam audio).
# Buat key di https://console.groq.com/keys. JANGAN commit .env yang berisi key.
GROQ_API_KEY=

# Video yang butuh login / batas usia: ambil cookies dari browser (kosongkan jika tidak perlu).
# Disarankan firefox; Chrome di Windows sering gagal dibaca karena enkripsi cookie.
YTDLP_COOKIES_BROWSER=

# Nama penceramah untuk tanda NAMA_BOCOR, dipisah koma. Kosong = pakai nama channel YouTube.
# Bila diisi, menimpa nama channel (channel lembaga). Contoh: QC_NAMA_PEMBICARA=Muhammad Nuzul Dzikri
QC_NAMA_PEMBICARA=
